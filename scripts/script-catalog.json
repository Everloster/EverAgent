{
  "schema_version": 1,
  "repository": "EverAgent",
  "scope": "identity-session-git-quality",
  "scripts": [
    {
      "id": "session.core",
      "description": "自动核实当前调用方的harness和模型；diagnose协助修复，declare仅记录用户兜底。",
      "entrypoint": "packages/everagent-core/cmd/everagent-identity/main.go",
      "owner": {
        "repository": "EverAgent",
        "path": "packages/everagent-core/identity.go"
      },
      "kind": "canonical",
      "aliases": [],
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "requirements": [
        "Go >=1.27 或预编译二进制"
      ],
      "input": "everagent-identity inspect|diagnose|declare [--json]",
      "output": "当前调用方的身份、证据、诊断或有期限声明",
      "side_effects": [
        "仅declare写当前会话声明"
      ],
      "authorization": {
        "repository": "EverAgent",
        "path": "docs/PROTOCOL_COMMON.md",
        "section": "A/C"
      },
      "scope": "当前调用方；不扫描其他会话正文"
    },
    {
      "id": "git.core",
      "description": "核实双身份；提交只消费暂存tree，绑定同源质量门、消息和前后身份。",
      "entrypoint": "packages/everagent-core/cmd/ea-git/main.go",
      "owner": {
        "repository": "EverAgent",
        "path": "packages/everagent-core/git.go"
      },
      "kind": "canonical",
      "aliases": [
        {
          "path": "scripts/ecommit.sh",
          "description": "薄Bash入口；构建并调用ea-git commit，不配置Git或跳过门禁。"
        }
      ],
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "requirements": [
        "Git",
        "Go >=1.27 或预编译二进制"
      ],
      "input": "ea-git [--repo-root <checkout>] validate|commit <Git消息参数>",
      "output": "Git退出码；消息与显式trailer由Git处理",
      "side_effects": [
        "commit写Git提交"
      ],
      "authorization": {
        "repository": "EverAgent",
        "path": "docs/PROTOCOL_COMMON.md",
        "section": "C"
      },
      "scope": "当前公开checkout和暂存tree"
    },
    {
      "id": "quality.public",
      "description": "检查公开内容、报告来源和复核快照、Context及索引；不调用模型或改历史产物。",
      "entrypoint": "packages/everagent-core/cmd/ea-quality/main.go",
      "owner": {
        "repository": "EverAgent",
        "path": "packages/everagent-core/internal/publicquality/gate.go"
      },
      "kind": "canonical",
      "aliases": [],
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "requirements": [
        "Git",
        "Go >=1.27",
        "匹配go.mod/go.sum的依赖缓存"
      ],
      "input": "ea-quality quick|full|context|catalog|report|privacy|links|policy|sampling|scripts|index [--scope index|worktree|head]",
      "output": "质量结果JSON；index --write更新三个生成视图",
      "side_effects": [
        "quick/full按影响面运行仓内Go回归",
        "仅index --write写生成视图"
      ],
      "authorization": {
        "repository": "EverAgent",
        "path": "docs/PROTOCOL_COMMON.md",
        "section": "D"
      },
      "scope": "当前公开快照；不读私仓、不做真实模型回放"
    },
    {
      "id": "evaluation.harness-experiment",
      "description": "消费可信评测器记录，按硬门和 Pareto 前沿选择最多三个 context 候选；不执行或发布。",
      "entrypoint": "scripts/harness_selection.py",
      "owner": {
        "repository": "EverAgent",
        "path": "scripts/harness_selection.py"
      },
      "kind": "canonical",
      "aliases": [],
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "requirements": [
        "Python >=3.10"
      ],
      "input": "--help",
      "output": "Harness selection v1; production_apply=false",
      "side_effects": [],
      "authorization": {
        "repository": "EverAgent",
        "path": "docs/PROTOCOL_COMMON.md",
        "section": "A"
      },
      "scope": "可信评测记录与一次有界实验"
    }
  ]
}
