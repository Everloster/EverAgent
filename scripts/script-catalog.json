{
  "schema_version": 1,
  "repository": "EverAgent",
  "scope": "identity-session-git",
  "scripts": [
    {
      "id": "agent.identity",
      "description": "自动核实当前 harness/model；失败先诊断并修复可行读取路径，用户指定兜底。",
      "entrypoint": "scripts/agent_identity.py",
      "owner": {
        "repository": "EverAgent",
        "path": "packages/everagent-core/src/everagent_core/identity/detect.py"
      },
      "kind": "canonical",
      "aliases": [
        {
          "path": "scripts/whoami_agent.py",
          "description": "旧 whoami 名称；转交同一公共 core 身份实现。"
        },
        {
          "path": "scripts/agent_identity/__init__.py",
          "description": "旧 Python 包 import 路径；转交同一公共 core。"
        }
      ],
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "requirements": [
        "Python >=3.10"
      ],
      "input": "inspect [--json|--name|--email|--git-ident] | diagnose --json",
      "output": "Agent identity v2 JSON | current-caller diagnosis v1; neither diagnosis nor configuration authorizes a model",
      "side_effects": [],
      "authorization": {
        "repository": "EverAgent",
        "path": "docs/PROTOCOL_COMMON.md",
        "section": "A"
      },
      "scope": "当前调用方和 checkout"
    },
