{
  "schema_version": 1,
  "repository": "EverAgent",
  "scope": "identity-session-git-quality",
  "scripts": [
    {
      "id": "session.core",
      "description": "自动核实当前调用方的harness和模型；diagnose协助修复，declare仅记录用户兜底。",
      "entrypoint": "packages/everagent-core/cmd/everagent-identity/main.go",
      "owner": {
        "repository": "EverAgent",
        "path": "packages/everagent-core/identity.go"
      },
      "kind": "canonical",
      "aliases": [],
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "requirements": [
        "Go >=1.27 或预编译二进制"
      ],
      "input": "everagent-identity inspect|diagnose|declare [--json]",
      "output": "当前调用方的身份、证据、诊断或有期限声明",
      "side_effects": [
        "仅declare写当前会话声明"
      ],
      "authorization": {
        "repository": "EverAgent",
        "path": "docs/PROTOCOL_COMMON.md",
        "section": "A/C"
      },
      "scope": "当前调用方；不扫描其他会话正文"
    },
    {
      "id": "git.core",
      "description": "固定仓库Author并核实Agent/模型Committer；合并复用同一身份流程，推送检查新增署名与撤销提交，不运行质量流水线。",
      "entrypoint": "packages/everagent-core/cmd/ea-git/main.go",
      "owner": {
        "repository": "EverAgent",
        "path": "packages/everagent-core/git.go"
      },
      "kind": "canonical",
      "aliases": [
        {
          "path": "scripts/ecommit.sh",
          "description": "调用同一egit commit入口，保留双身份与新增内容检查。"
        },
        {
          "path": "scripts/egit.sh",
          "description": "构建并调用仓库绑定的ea-git commit/merge/push，不跳过已有hooks。"
        }
      ],
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "requirements": [
        "Git",
        "Go >=1.27 或预编译二进制"
      ],
      "input": "ea-git [--repo-root <checkout>] validate|commit|merge|push <对应参数>",
      "output": "Git退出码；消息与显式trailer由Git处理",
      "side_effects": [
        "commit/merge写Git提交或工作树",
        "push写明确远端分支"
      ],
      "authorization": {
        "repository": "EverAgent",
        "path": "docs/PROTOCOL_COMMON.md",
        "section": "C"
      },
      "scope": "当前公开checkout和暂存tree"
    },
    {
      "id": "quality.public",
      "description": "disclosure/quick只查新增公开内容；其余质量、Context和索引工具按需使用，不调用模型或改历史原件。",
      "entrypoint": "packages/everagent-core/cmd/ea-quality/main.go",
      "owner": {
        "repository": "EverAgent",
        "path": "packages/everagent-core/internal/publicquality/gate.go"
      },
      "kind": "canonical",
      "aliases": [],
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "requirements": [
        "Git",
        "Go >=1.27",
        "匹配go.mod/go.sum的依赖缓存"
      ],
      "input": "ea-quality disclosure|quick|full|context|catalog|report|privacy|links|policy|sampling|scripts|index [--scope index|worktree|head]",
      "output": "质量结果JSON；index --write更新三个生成视图",
      "side_effects": [
        "仅显式full可能运行快照中的Go回归；disclosure/quick不运行测试",
        "仅index --write写生成视图"
      ],
      "authorization": {
        "repository": "EverAgent",
        "path": "docs/PROTOCOL_COMMON.md",
        "section": "D"
      },
      "scope": "当前公开快照；不读私仓、不做真实模型回放"
    },
    {
      "id": "evaluation.harness-experiment",
      "description": "消费可信评测器记录，按硬门和 Pareto 前沿选择最多三个 context 候选；不执行或发布。",
      "entrypoint": "scripts/harness_selection.py",
      "owner": {
        "repository": "EverAgent",
        "path": "scripts/harness_selection.py"
      },
      "kind": "canonical",
      "aliases": [],
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "requirements": [
        "Python >=3.10"
      ],
      "input": "--help",
      "output": "Harness selection v1; production_apply=false",
      "side_effects": [],
      "authorization": {
        "repository": "EverAgent",
        "path": "docs/PROTOCOL_COMMON.md",
        "section": "A"
      },
      "scope": "可信评测记录与一次有界实验"
    }
  ]
}
