#!/bin/sh
# Optional repository hook: Committer identity plus new public-content disclosure.
# Do not install it over a user's existing core.hooksPath.
set -eu
REPO_ROOT="$(git rev-parse --show-toplevel)"
go -C "$REPO_ROOT/packages/everagent-core" run -mod=readonly -trimpath -buildvcs=false \
  ./cmd/ea-git --repo-root "$REPO_ROOT" validate
if [ "${EVERAGENT_PUBLIC_CONTENT_TREE:-}" != "$(git write-tree)" ]; then
    go -C "$REPO_ROOT/packages/everagent-core" run -mod=readonly -trimpath -buildvcs=false \
      ./cmd/ea-quality disclosure --repo-root "$REPO_ROOT" --scope index
fi
