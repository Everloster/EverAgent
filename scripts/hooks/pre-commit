#!/bin/sh
# EverAgent pre-commit hook: validate git identity before commit
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

REPO_ROOT="$(git rev-parse --show-toplevel)"
IDENTITY_SCRIPT="$REPO_ROOT/scripts/git_identity.py"

if [ -f "$IDENTITY_SCRIPT" ]; then
    python3 "$IDENTITY_SCRIPT" validate
    if [ $? -ne 0 ]; then
        echo "[pre-commit] BLOCKED: git identity check failed."
        exit 1
    fi
fi

exit 0
