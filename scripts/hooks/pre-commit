#!/bin/sh
# Defense in depth; do not replace a user's existing core.hooksPath.
set -eu
REPO_ROOT="$(git rev-parse --show-toplevel)"
go -C "$REPO_ROOT/packages/everagent-core" run -mod=readonly -trimpath -buildvcs=false \
  ./cmd/ea-git --repo-root "$REPO_ROOT" validate
if [ "${EVERAGENT_QUALITY_GATE_TREE:-}" != "$(git write-tree)" ]; then
    go -C "$REPO_ROOT/packages/everagent-core" run -mod=readonly -trimpath -buildvcs=false \
      ./cmd/ea-quality quick --repo-root "$REPO_ROOT" --scope index
fi
