{
  "protocol": "aamp",
  "version": "1.1",
  "profile": "everagent-local-control-plane",
  "intents": [
    "task.dispatch",
    "task.cancel",
    "task.ack",
    "task.help_needed",
    "task.result",
    "task.stream.opened"
  ],
  "capabilities": {
    "stream": {
      "transport": "events-dir",
      "createAction": "task_exec.start",
      "appendAction": "ea_events.emit_event",
      "closeAction": "task_exec.finish",
      "getAction": "ea_events.load_events",
      "subscribeUrlTemplate": "events/{date}/evt_*.yaml"
    }
  },
  "api": {
    "url": "local:scripts/everagent.py"
  },
  "notes": {
    "mailboxRuntime": "out-of-scope",
    "sdkHelperCompatibility": "out-of-scope",
    "adapterSpec": "docs/AAMP_ADAPTER.md"
  }
}
