<?xml version="1.0" encoding="UTF-8"?>
<!--
  EverAgent T012: github-trending-analyzer 周报自动化 LaunchAgent

  Install:
    1. cp scripts/launchd/com.github-trending-analyzer.weekly.plist.template \
          ~/Library/LaunchAgents/com.github-trending-analyzer.weekly.plist
    2. Replace {{PROJECT_ROOT}} with absolute path (e.g. /Users/jabe/workspace/EverAgent)
    3. Replace {{LOG_DIR}} with absolute path for logs
    4. launchctl load ~/Library/LaunchAgents/com.github-trending-analyzer.weekly.plist

  Verify:
    launchctl list | grep github-trending
    tail -f {{LOG_DIR}}/weekly-trending.log

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.github-trending-analyzer.weekly.plist
    rm ~/Library/LaunchAgents/com.github-trending-analyzer.weekly.plist

  Schedule: Sundays at 09:17 local time (off the hour to avoid fleet collisions).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github-trending-analyzer.weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>{{PROJECT_ROOT}}/github-trending-analyzer/scripts/weekly_trending_report.py</string>
        <string>--since</string>
        <string>weekly</string>
        <string>--dispatch</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{PROJECT_ROOT}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TRENDING_REPORTS_DIR</key>
        <string>{{PROJECT_ROOT}}/github-trending-analyzer/github-trending-reports</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>17</integer>
        <key>Weekday</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/weekly-trending.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/weekly-trending.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>